name: immich

services:
  immich-server:
    container_name: immich_server
    image: pi-security/immich-server:{{ security_runtime_revision }}
    # extends:
    #   file: hwaccel.transcoding.yml
    #   service: cpu # set to one of [nvenc, quicksync, rkmpp, vaapi, vaapi-wsl] for accelerated transcoding
    volumes:
      # Do not edit the next line. If you want to change the media storage location on your system, edit the value of UPLOAD_LOCATION in the .env file
      - ${UPLOAD_LOCATION}:/data
      - /etc/localtime:/etc/localtime:ro
    env_file:
      - .env
    ports:
      - '{{ immich.port }}:2283'
    depends_on:
      - redis
      - database
    restart: always
    healthcheck:
      disable: false

  immich-machine-learning:
    container_name: immich_machine_learning
    # Select accelerated source variants in security-runtime/defaults/main.yml.
    image: pi-security/immich-machine-learning:{{ security_runtime_revision }}
    # extends: # uncomment this section for hardware acceleration - see https://docs.immich.app/features/ml-hardware-acceleration
    #   file: hwaccel.ml.yml
    #   service: cpu # set to one of [armnn, cuda, rocm, openvino, openvino-wsl, rknn] for accelerated inference - use the `-wsl` version for WSL2 where applicable
    volumes:
      - model-cache:/cache
    env_file:
      - .env
    restart: always
    healthcheck:
      disable: false

  redis:
    container_name: immich_redis
    image: pi-security/immich-valkey:{{ security_runtime_revision }}
    healthcheck:
      test: redis-cli ping || exit 1
    restart: always

  database:
    container_name: immich_postgres
    image: pi-security/immich-postgres:{{ security_runtime_revision }}
    environment:
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_DB: ${DB_DATABASE_NAME}
      POSTGRES_INITDB_ARGS: '--data-checksums'
      # Uncomment the DB_STORAGE_TYPE: 'HDD' var if your database isn't stored on SSDs
      # DB_STORAGE_TYPE: 'HDD'
    env_file:
      - .env
    volumes:
      # Do not edit the next line. If you want to change the database storage location on your system, edit the value of DB_DATA_LOCATION in the .env file
      - ${DB_DATA_LOCATION}:/var/lib/postgresql/data
    shm_size: 128mb
    # /etc/postgresql holds the runtime config generated by the image entrypoint,
    # which copies its template with `cp -n` and so refuses to overwrite an existing
    # file. An unclean shutdown can zero that file's data blocks while preserving its
    # size, leaving postgres in a permanent crash loop ("syntax error ... near token")
    # that no restart clears -- only recreating the container does. Backing the
    # directory with tmpfs makes it empty on every start, so the entrypoint always
    # regenerates a valid config. The image ships this directory empty, so nothing is
    # masked, and the real tuning file in PGDATA is pulled in via include_if_exists.
    tmpfs:
      - /etc/postgresql:mode=1777
    restart: always

volumes:
  model-cache: