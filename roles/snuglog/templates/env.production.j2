# =============================================================================
# Snuglog Production Environment
# =============================================================================
# Managed by Ansible (roles/snuglog). Do not edit on the host: the next
# playbook run overwrites this file. Change group_vars/all.yml or vault.yml.
# =============================================================================

# --- PostgreSQL (used by the postgres container to init the database) ---
POSTGRES_USER={{ snuglog.db.user }}
POSTGRES_PASSWORD={{ snuglog_db_password }}
POSTGRES_DB={{ snuglog.db.name }}

# --- App: Database ---
# The host has to be the compose service name of the production database.
DATABASE_URL=postgresql://{{ snuglog.db.user }}:{{ snuglog_db_password }}@{{ snuglog.db.host }}:5432/{{ snuglog.db.name }}

# --- App: Auth ---
BETTER_AUTH_URL=https://{{ snuglog.domain }}
BETTER_AUTH_SECRET={{ snuglog_better_auth_secret }}
AUTH_GOOGLE_ID={{ snuglog_google_auth_id }}
AUTH_GOOGLE_SECRET={{ snuglog_google_auth_secret }}

# --- Alice skill ---
ALICE_PUBLIC_BASE_URL=https://{{ snuglog.domain }}
ALICE_SKILL_ID={{ snuglog_alice_skill_id }}
ALICE_OAUTH_CLIENT_ID={{ snuglog.alice.oauth_client_id }}
ALICE_OAUTH_CLIENT_SECRET={{ snuglog_alice_oauth_client_secret }}
ALICE_OAUTH_REDIRECT_URI={{ snuglog.alice.oauth_redirect_uri }}
ALICE_TRUST_PROXY_IP_HEADERS={{ snuglog.alice.trust_proxy_ip_headers | lower }}
CEREBRAS_API_KEY={{ snuglog_cerebras_api_key }}
ALICE_INTERPRETER_RATE_LIMIT_PER_MINUTE={{ snuglog.alice.interpreter_rate_limit_per_minute }}

# --- Watchlist metadata ---
TMDB_API_KEY={{ snuglog_tmdb_api_key }}
# Path inside the container; it has to match the compose bind mount target.
WATCHLIST_IMAGE_DIR={{ snuglog.container_images_directory }}
